  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Retention Cohort Heatmap (% вернувшихся пользователей когорты)",
      "description": "Когорта = день первого просмотра (VIEW_STARTED). Day N = доля пользователей когорты, совершивших любое событие через N дней. Пустые ячейки — день ещё не наступил.",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "-- Источник: агрегат cinema.agg_retention_cohort (п.5), не raw-события\nSELECT\n  toString(cohort_date) AS `Когорта`,\n  max(cohort_size)      AS `Пользователей`,\n  if(cohort_date + 0 > today(), NULL, maxIf(retention_pct, day_number = 0)) AS `Day 0`,\n  if(cohort_date + 1 > today(), NULL, maxIf(retention_pct, day_number = 1)) AS `Day 1`,\n  if(cohort_date + 2 > today(), NULL, maxIf(retention_pct, day_number = 2)) AS `Day 2`,\n  if(cohort_date + 3 > today(), NULL, maxIf(retention_pct, day_number = 3)) AS `Day 3`,\n  if(cohort_date + 4 > today(), NULL, maxIf(retention_pct, day_number = 4)) AS `Day 4`,\n  if(cohort_date + 5 > today(), NULL, maxIf(retention_pct, day_number = 5)) AS `Day 5`,\n  if(cohort_date + 6 > today(), NULL, maxIf(retention_pct, day_number = 6)) AS `Day 6`,\n  if(cohort_date + 7 > today(), NULL, maxIf(retention_pct, day_number = 7)) AS `Day 7`\nFROM cinema.agg_retention_cohort FINAL\nWHERE cohort_date >= today() - 14\nGROUP BY cohort_date\nORDER BY cohort_date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "continuous-RdYlGr"
          },
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "color-background",
              "mode": "gradient"
            }
          },
          "noValue": ""
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Когорта"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "unit",
                "value": "string"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Пользователей"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "DAU",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
