    {
      "id": 7,
      "type": "timeseries",
      "title": "Retention D1 / D7 по когортам, %",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toDateTime(metric_date) AS time,\n  maxIf(value, metric_name = 'retention_d1') AS `D1`,\n  maxIf(value, metric_name = 'retention_d7') AS `D7`\nFROM cinema.agg_daily_metrics FINAL\nWHERE metric_name IN ('retention_d1','retention_d7') AND metric_date >= today() - 14\nGROUP BY metric_date\nORDER BY time"
        }
      ],
      "fieldConfig": {
